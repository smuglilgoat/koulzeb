# Copy to `.env` for local dev (netlify dev reads it) and add the same values
# in Netlify: Site configuration > Environment variables.

# Required for Google Places restaurant search. Server-side only — never exposed
# to the browser. Create it in Google Cloud Console (see README).
GOOGLE_PLACES_API_KEY=

# Hard cap on Places calls per calendar month, enforced by the app. Keep at or
# below the SKU's free cap so you never get billed:
#   5000 = Text Search Pro (name/address/map link)  -> default
#   1000 = if you also enable rating/price below (Enterprise fields)
PLACES_MONTHLY_LIMIT=5000

# Set to "true" to also request rating + price level. This moves requests to the
# Enterprise SKU (1,000 free/month) — lower PLACES_MONTHLY_LIMIT to 1000 if you do.
PLACES_INCLUDE_RATING=false
